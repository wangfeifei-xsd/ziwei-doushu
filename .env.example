# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI / sub2api / 其他 OpenAI 兼容服务）───
# 只看排盘无需填写；AI 解读和合盘分析需要填完下面三项。
# 推理请求由服务端发起，变量不需要添加 NEXT_PUBLIC_ 前缀。
OPENAI_API_KEY=your-api-key
# 填 API Base URL，通常以 /v1 结尾；不要填控制台的 /keys 页面或完整接口路径。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-model-name
# responses 调用 /responses；chat 调用 /chat/completions。按服务商支持的协议选择。
OPENAI_API_MODE=responses
# 也可在 /settings/model 页面配置并立即生效；页面保存的设置优先于上述环境变量。
# 默认随 H2_DATA_DIR 或项目 data/ 保存 ai-config.json，可独立指定持久化目录。
# AI_CONFIG_DIR=./data

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 原生应用公开分享站点（编译环境设置，不能放模型密钥）：
# VITE_SITE_URL=https://your-site.example

# ─── 嵌入式 H2 档案数据库 ───
# H2 驱动随项目提供，无需另装数据库；运行环境需 Java 17+ JDK。
# 默认在项目 data/ 目录保存 ziwei.mv.db，可改为外部持久化目录。
# H2_DATA_DIR=./data
# Java 不在 PATH 中时，填写 java 可执行文件的完整路径。
# JAVA_BIN=/path/to/jdk/bin/java
