{
  "name": "ziwei-doushu",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "build": "npm run build:web",
    "start": "npm run start:web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test:ai": "tsx scripts/regression/ai-stream.test.ts",
    "test:model-config": "tsx scripts/regression/model-config.test.ts",
    "test:profiles": "tsx scripts/regression/profiles.test.ts",
    "test": "npm run test:ai && npm run test:model-config && npm run test:profiles && tsx scripts/regression/pan-integrity.test.ts && tsx scripts/regression/dst-cn.test.ts && tsx scripts/regression/clock-adjust.test.ts && tsx scripts/regression/sizhu-lichun-boundary.test.ts && tsx scripts/regression/hongluan-tianxi.test.ts && tsx scripts/regression/famous-hour-consistency.test.ts && tsx scripts/regression/iztro-time-index-boundary.test.ts && tsx scripts/regression/solar-date-exists.test.ts && tsx scripts/regression/natal-dual-sihua-same-palace.test.ts && tsx scripts/regression/neutral-naming.test.ts && npm run test:shared && npm run check:boundaries",
    "dev:web": "npm run dev -w @ziwei/web",
    "start:web": "npm run start -w @ziwei/web",
    "build:web": "npm run assets && npm run build -w @ziwei/web && npm run package:web",
    "assets": "node scripts/sync-assets.mjs",
    "dev:app": "npm run tauri -w @ziwei/native -- dev",
    "dev:app:web": "npm run assets && npm run dev -w @ziwei/native",
    "dev:android": "npm run tauri -w @ziwei/native -- android dev",
    "dev:ios": "npm run tauri -w @ziwei/native -- ios dev",
    "build:app": "npm run assets && npm run build -w @ziwei/native",
    "build:desktop": "npm run tauri -w @ziwei/native -- build",
    "build:android": "npm run tauri -w @ziwei/native -- android build",
    "build:ios": "npm run tauri -w @ziwei/native -- ios build",
    "web:up": "node scripts/service.mjs start web",
    "web:down": "node scripts/service.mjs stop web",
    "web:status": "node scripts/service.mjs status web",
    "check:versions": "node scripts/check-versions.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:shared": "tsx scripts/regression/shared-migration.test.ts",
    "test:scripts": "node scripts/regression/service-lifecycle.test.mjs",
    "test:e2e:web": "playwright test",
    "test:native": "cargo test --manifest-path apps/native/src-tauri/Cargo.toml --locked --lib",
    "package:web": "node scripts/package-web.mjs",
    "export:h2": "tsx scripts/export-h2-profiles.ts",
    "app-web:up": "node scripts/service.mjs start app-web",
    "app-web:down": "node scripts/service.mjs stop app-web",
    "services:status": "node scripts/service.mjs status --all",
    "services:down": "node scripts/service.mjs stop --all"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
